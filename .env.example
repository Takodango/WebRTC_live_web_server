PUBLIC_SCHEME=https
PUBLIC_HOST=your-domain.example
PUBLIC_HOSTNAME=your-domain.example
LAN_HTTPS_HOST=192.168.1.10
WEBRTC_ADDITIONAL_HOSTS=192.168.1.10,your-domain.example
APP_PORT=7031
WEBRTC_ICE_PORT=8189
RTMP_PORT=1935
RTSP_PORT=8554
